# Copy this file to .env.local and fill in your key.
# .env.local is never committed; see .gitignore.

# Your Anthropic API key. Without it every non-tutor feature still works and
# the tutor and grading areas show a setup screen.
ANTHROPIC_API_KEY=

# Model used for the streaming tutor conversation.
LAB_TUTOR_MODEL=claude-sonnet-5-5

# Smaller, cheaper model used for grading, summaries and concept proposals.
LAB_GRADER_MODEL=claude-haiku-5-5
