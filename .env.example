# Copy to .env.local for local development. Everything is optional locally.

# --- Access -------------------------------------------------------------
# Single passcode for the app. Unset = open (fine on localhost, NOT on Vercel).
APP_PASSCODE=
# Optional: secret for signing the session cookie (defaults to one derived from the passcode).
SESSION_SECRET=

# --- Claude (server-side only; never exposed to the browser) ------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Database -----------------------------------------------------------
# Unset = embedded PGlite in ./.data/pglite (zero setup, local only).
# Supabase: use the transaction pooler string (port 6543), e.g.
# postgres://postgres.<ref>:<password>@aws-0-eu-north-1.pooler.supabase.com:6543/postgres
DATABASE_URL=
# Run migrations + seed on first connection (handy for a fresh DB; normally run npm run db:migrate)
DB_AUTO_MIGRATE=

# --- File storage for recipe photos / files -----------------------------
# local (./.data/uploads) or supabase
BLOB_STORE=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=mise-originals

# --- Stores -------------------------------------------------------------
# Your S-market / Prisma as named in S-kaupat (editable later under More → Stores)
S_MARKET_STORE=
S_KAUPAT_STORE_ID=
# S-kaupat product data: mock (invented demo catalogue) | none. Default: mock in dev, none in production.
S_KAUPAT_ADAPTER=

# --- Dev only -----------------------------------------------------------
# Extra hosts allowed to load `next dev` (e.g. your laptop's LAN IP to test on the phone)
DEV_ORIGINS=
